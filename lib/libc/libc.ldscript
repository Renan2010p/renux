/*
 * Renux userland linker script.
 *
 * Produces a static, non-PIE ELF64 executable linked at a fixed low address so
 * the kernel's ELF loader can map it straight from the program headers.
 */

OUTPUT_FORMAT(elf64-x86-64)
ENTRY(_start)

SECTIONS
{
	. = 0x00400000;

	.text : ALIGN(0x1000)
	{
		*(.text)
		*(.text.*)
	}

	. = ALIGN(0x1000);
	.rodata :
	{
		*(.rodata)
		*(.rodata.*)
	}

	. = ALIGN(0x1000);
	.data :
	{
		*(.data)
		*(.data.*)
	}

	.bss :
	{
		*(.bss)
		*(.bss.*)
		*(COMMON)
	}

	/DISCARD/ :
	{
		*(.eh_frame)
		*(.eh_frame.*)
		*(.comment)
		*(.note.*)
	}
}
